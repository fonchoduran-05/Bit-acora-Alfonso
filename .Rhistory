!is.na(FixedorVariableInterestInd)
) |>
group_by(ApprovalFY, FixedorVariableInterestInd) |>
summarise(
cantidad = n(),
tasa_promedio = mean(InitialInterestRate),
.groups = "drop"
)
sba_tasas_recientes |>
group_by(FixedorVariableInterestInd) |>
summarise(
cantidad = n(),
media = mean(InitialInterestRate),
mediana = median(InitialInterestRate),
desvio = sd(InitialInterestRate)
)
t.test(
InitialInterestRate ~ FixedorVariableInterestInd,
data = sba_tasas_recientes
)
sba_2025 <- sba |>
dplyr::filter(lubridate::year(ApprovalDate) == 2025)
nrow(sba_2025)
library(tidyverse)
sba_2025 |>
summarise(
mediana = median(GrossApproval, na.rm = TRUE),
percentil_90 = quantile(GrossApproval, 0.90, na.rm = TRUE)
)
montos_2025 <- sba_2025$GrossApproval
montos_2025 <- montos_2025[!is.na(montos_2025)]
n <- length(montos_2025)
set.seed(123)
B <- 1000
n <- length(montos_2025)
bootstrap <- replicate(B, {
muestra_boot <- sample(
montos_2025,
size = n,
replace = TRUE
)
c(
mediana = median(muestra_boot),
p90 = quantile(muestra_boot, 0.90, names = FALSE)
)
})
bootstrap <- as.data.frame(t(bootstrap))
head(bootstrap)
str(bootstrap)
ggplot(bootstrap, aes(x = mediana)) +
geom_histogram(bins = 30) +
labs(
title = "Distribución bootstrap de la mediana",
x = "Mediana de GrossApproval",
y = "Frecuencia"
)
ggplot(bootstrap, aes(x = p90)) +
geom_histogram(bins = 30) +
labs(
title = "Distribución bootstrap del percentil 90",
x = "Percentil 90 de GrossApproval",
y = "Frecuencia"
)
IC_mediana <- quantile(
bootstrap$mediana,
probs = c(0.025, 0.975)
)
IC_mediana
IC_p90 <- quantile(
bootstrap$p90,
probs = c(0.025, 0.975)
)
IC_p90
