ggplot(sba, aes(x = JobsSupported)) +
geom_histogram(binwidth = 2, na.rm = TRUE) +
coord_cartesian(xlim = c(0, 100)) +
labs(
title = "Distribución de JobsSupported",
subtitle = "Visualización entre 0 y 100 empleos apoyados",
x = "Cantidad de empleos apoyados",
y = "Cantidad de préstamos"
)
x_rango <- 0:100
jobs_clean <- sba$JobsSupported[!is.na(sba$JobsSupported) & sba$JobsSupported >= 0]
N_total <- length(jobs_clean)
lambda_hat <- mean(jobs_clean)
obs_conteo <- as.numeric(table(factor(jobs_clean[jobs_clean <= 100], levels = x_rango)))
esp_conteo <- N_total * dpois(x_rango, lambda = lambda_hat)
df_barras <- data.frame(
Empleos = x_rango,
Observado = obs_conteo,
`Esperado (Poisson)` = esp_conteo
) %>%
pivot_longer(cols = c("Observado", "Esperado..Poisson."),
names_to = "Distribución",
values_to = "Frecuencia") %>%
mutate(Distribución = ifelse(Distribución == "Observado", "Observado", "Esperado (Poisson)"))
ggplot(df_barras, aes(x = Empleos, y = Frecuencia, fill = Distribución)) +
geom_col(position = position_dodge(width = 0.8), width = 0.7) +
scale_fill_manual(values = c("Observado" = "steelblue", "Esperado (Poisson)" = "tomato")) +
labs(
title = "Comparación: Frecuencia Observada vs Poisson Teórica (0 a 100 empleos)",
x = "Número de Empleos Apoyados (JobsSupported)",
y = "Cantidad de Préstamos (Frecuencia)",
fill = "Tipo"
) +
theme_minimal(base_size = 13) +
theme(legend.position = "top")
sba |>
summarise(
minimo = min(JobsSupported, na.rm = TRUE),
media = mean(JobsSupported, na.rm = TRUE),
mediana = median(JobsSupported, na.rm = TRUE),
varianza = var(JobsSupported, na.rm = TRUE),
maximo = max(JobsSupported, na.rm = TRUE)
)
# Sacamos los NA
jobs <- sba$JobsSupported
jobs <- jobs[!is.na(jobs)]
# Estimamos lambda con la media
lambda <- mean(jobs)
# Probabilidades para comparar cuantiles
p <- ppoints(length(jobs))
# Cuantiles observados
q_observados <- quantile(jobs, probs = p, names = FALSE)
# Cuantiles teóricos de una Poisson
q_poisson <- qpois(p, lambda = lambda)
# QQ-plot
plot(
q_poisson,
q_observados,
xlab = "Cuantiles teóricos Poisson",
ylab = "Cuantiles observados",
main = "QQ-plot: JobsSupported vs Poisson"
)
abline(0, 1)
plot(
q_poisson,
q_observados,
xlab = "Cuantiles teóricos Poisson",
ylab = "Cuantiles observados",
main = "QQ-plot: JobsSupported vs Poisson",
xlim = c(0, 50),
ylim = c(0, 50)
)
abline(0, 1)
sba |>
count(ProcessingMethod) |>
arrange(desc(n))
sba_express <- sba |>
filter(ProcessingMethod == "SBA Express Program")
nrow(sba_express)
sba_express |>
summarise(
media = mean(GrossApproval, na.rm = TRUE),
mediana = median(GrossApproval, na.rm = TRUE),
desvio = sd(GrossApproval, na.rm = TRUE),
minimo = min(GrossApproval, na.rm = TRUE),
maximo = max(GrossApproval, na.rm = TRUE)
)
ggplot(sba_express, aes(x = GrossApproval)) +
geom_histogram(bins = 50) +
scale_x_continuous(
labels = scales::label_number(big.mark = ".")
) +
labs(
title = "Distribución del monto aprobado - SBA Express Program",
x = "Monto aprobado (USD)",
y = "Frecuencia"
)
library(fitdistrplus)
montos <- sba_express$GrossApproval
montos <- montos[!is.na(montos) & montos > 0]
media_montos <- mean(montos)
var_montos <- var(montos)
shape_gamma <- media_montos^2 / var_montos
rate_gamma <- media_montos / var_montos
shape_gamma
rate_gamma
meanlog_lognormal <- mean(log(montos))
sdlog_lognormal <- sd(log(montos))
meanlog_lognormal
sdlog_lognormal
ggplot(data.frame(montos), aes(x = montos)) +
geom_histogram(
aes(y = after_stat(density)),
bins = 50
) +
stat_function(
aes(linetype = "Gamma"),
fun = dgamma,
args = list(
shape = shape_gamma,
rate = rate_gamma
),
linewidth = 0.6
) +
stat_function(
aes(linetype = "Lognormal"),
fun = dlnorm,
args = list(
meanlog = meanlog_lognormal,
sdlog = sdlog_lognormal
),
linewidth = 0.6
) +
scale_linetype_manual(
name = "Distribución",
values = c(
"Gamma" = "solid",
"Lognormal" = "dashed"
)
) +
scale_x_continuous(
labels = scales::label_number(big.mark = ".")
) +
labs(
title = "Comparación de distribuciones ajustadas",
x = "Monto aprobado (USD)",
y = "Densidad"
)
puntos <- c(25000, 50000, 100000, 250000, 500000)
observada <- sapply(
puntos,
function(x) mean(montos <= x)
)
gamma <- pgamma(
puntos,
shape = shape_gamma,
rate = rate_gamma
)
lognormal <- plnorm(
puntos,
meanlog = meanlog_lognormal,
sdlog = sdlog_lognormal
)
data.frame(
Monto = puntos,
Observada = observada,
Gamma = gamma,
Lognormal = lognormal
)
prob_observada <- mean(montos > 500000)
prob_gamma <- 1 - pgamma(
500000,
shape = shape_gamma,
rate = rate_gamma
)
prob_lognormal <- 1 - plnorm(
500000,
meanlog = meanlog_lognormal,
sdlog = sdlog_lognormal
)
data.frame(
Modelo = c("Datos observados", "Gamma", "Lognormal"),
Probabilidad = c(
prob_observada,
prob_gamma,
prob_lognormal
)
)
